<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Game Center mirrors the achievements the app already keeps locally.
         The capability has to be enabled for the App ID as well, and each
         achievement created in App Store Connect with the identifier the app
         reports; until then Game Center refuses the report and the app says
         so rather than pretending it went through. -->
    <key>com.apple.developer.game-center</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.sergiiziborov.GopherForge</string>
    </array>
</dict>
</plist>
