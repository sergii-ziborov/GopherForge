# Runtime packaging for a verified Next standalone build when the origin has
# insufficient capacity for a full source build. Build context: the release
# directory containing standalone/, Dockerfile and bundle-receipt.json.
FROM docker.io/library/node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN groupadd --gid 10001 web && useradd --uid 10001 --gid web --no-create-home web
COPY standalone/ ./
# Next's trace can contain the builder's macOS sharp binary. Install the exact
# sharp version for the Linux runtime, then redirect its traced dependency links.
RUN npm install --prefix /native --omit=dev --ignore-scripts --package-lock=false --no-audit --no-fund sharp@0.35.5 \
    && find /app/node_modules -type l -name sharp -exec ln -sfn /native/node_modules/sharp {} \; \
    && npm cache clean --force
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
