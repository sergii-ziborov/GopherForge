{
  "name": "gopherforge-mcp",
  "version": "0.1.0",
  "description": "Official GopherForge MCP server: encrypted agent collaboration with the Go Playground on web, iPhone and iPad.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Serhii Ziborov",
  "homepage": "https://gopherforge.app/guide/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/GopherForge.git",
    "directory": "packages/gopherforge-mcp"
  },
  "bugs": "https://github.com/sergii-ziborov/GopherForge/issues",
  "keywords": [
    "gopherforge",
    "mcp",
    "golang",
    "playground",
