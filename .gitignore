.DS_Store
*.log
.env
.artifact-cache/
.build/
DerivedData*/
# The generated project is tracked, and only because Xcode Cloud discovers
# products from the repository at workflow setup, before ci_post_clone.sh has
# had a chance to generate it. project.yml stays the source of truth; regenerate
# and commit together.
# GopherForge.xcodeproj/  (tracked; see above)
# The bundled toolchain is built, not committed: scripts/build_toolchain.sh
# produces ~180 MB from a stock Go release in about fifteen seconds, and a
# binary artifact in git would be a copy of Go that nobody rebases.
GopherForge/Resources/Toolchain/*/
GopherForge/Resources/Toolchain/*.staging.*/
*.xcresult
xcuserdata/
build/

# Internal release notes stay off the public remote
/docs/TESTFLIGHT-*.md
/docs/APP-STORE.md
/docs/DEVICE-GATE.md
/docs/HARDEN-*.md
/docs/RELEASE-AUDIT-*.md
/docs/GAME-CENTER.md
/docs/app-store/*.json
!/docs/app-store/screenshot-order.json
/release-evidence/
# Release, App Store, hosting, publication, audit and design records are
# operational evidence. They stay on the maintainer's machine; the public tree
# keeps what builds, scripts and readers use.
/AGENTS.md
/docs/hosting-*.md
/docs/operations/
/docs/releases/
/docs/branding/
/docs/app-store/metadata/
/docs/app-store/listing.md
/docs/audits/*
!/docs/audits/2026-10-28-interview-expansion.json
/docs/curriculum/
/docs/website/*
!/docs/website/lessons.json
__pycache__/
